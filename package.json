{
  "name": "cbam-auto-filler",
  "productName": "CBAM 申報助手",
  "private": true,
  "version": "0.1.5",
  "description": "Desktop tool for Taiwanese SMEs filling the EU CBAM communication template",
  "author": "NCHU CBAM project",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "tsc --noEmit",
    "preview": "vite preview",
    "template:map": "python tools/gen_template_map.py --report",
    "defaults:map": "python tools/gen_default_values.py --report",
    "desktop": "electron .",
    "dist": "vite build && electron-builder --publish never",
    "dist:win": "vite build && electron-builder --win --publish never",
    "dist:win:local": "vite build && electron-builder --win --publish never --config.electronDist=node_modules/electron/dist",
    "dist:mac": "vite build && electron-builder --mac --publish never"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans-tc": "^5.3.0",
    "exceljs": "4.4.0",
    "jszip": "3.10.1",
    "lucide-react": "^0.576.0",
    "motion": "^13.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "build": {
    "appId": "tw.edu.nchu.cbam.autofiller",
    "productName": "CBAM Auto-Filler",
    "directories": { "output": "release" },
    "files": ["dist/**", "electron/**", "package.json"],
    "extraResources": [{ "from": "template", "to": "template", "filter": ["*.xlsx"] }],
    "win": { "target": "nsis", "artifactName": "CBAM-Auto-Filler-${version}-setup.${ext}" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "perMachine": false },
    "mac": {
      "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }],
      "category": "public.app-category.productivity",
      "artifactName": "CBAM-Auto-Filler-${version}-${arch}.${ext}",
      "identity": "-",
      "hardenedRuntime": false
    },
    "fileAssociations": [{ "ext": "cbam", "name": "CBAM project", "role": "Editor" }]
  }
}
